# Plantilla de api/.env. Copiala a api/.env y ajusta lo que necesites.
# Los valores de abajo son los medidos en el laboratorio (ver "Resultados" en el README).

# Puerto donde escucha la API.
PORT=3000
# Conexion a Postgres. Usuario, clave y base deben coincidir con docker-compose.yml.
DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_db

# Tamano OBJETIVO de cada chunk, en caracteres, y cuanto se repite del chunk
# anterior (como maximo, y siempre en oraciones completas). En los .md un chunk puede
# pasar del objetivo hasta un 25 % para no dejar una cola de pocas lineas.
# CHUNK_OVERLAP debe ser menor que CHUNK_SIZE o la API no arranca.
# Si los cambias, hay que borrar y volver a subir los documentos.
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Donde corre Ollama y que modelo genera los embeddings (1024 dimensiones,
# igual que vector(1024) en db/init.sql).
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3

# Modelo que redacta la respuesta en /ask.
CHAT_MODEL=llama3.2:3b
# Similitud coseno minima (0 a 1) para que un chunk cuente como relevante.
# Si ninguno la alcanza, /ask responde sin llamar al modelo de chat.
MIN_SIMILARITY=0.45

# Estilo de respuesta de /ask. false (por defecto): respuesta directa.
# true: el modelo escribe una linea de razonamiento y despues la respuesta; ayuda con
# rangos y cuentas, pero cuesta mas tokens y con llama3.2:3b no mejora. Al cambiarlo hay
# que reiniciar la API.
ASK_REASONING=false
